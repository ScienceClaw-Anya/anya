NEUROTARGET_AGENT_MODE=demo
# Optional OpenAI-compatible endpoint, e.g. a privately configured Nebius Token Factory endpoint.
NEUROTARGET_LLM_BASE_URL=
NEUROTARGET_LLM_MODEL=
NEUROTARGET_LLM_API_KEY=
NEUROTARGET_LLM_MAX_TOKENS=500

# Native ScienceClaw Gemini backend. Use the pre-provisioned Workshop API key.
LLM_BACKEND=gemini
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_KEY=
GEMINI_REASONING_EFFORT=low
GEMINI_THINKING_HEADROOM=1024
GEMINI_MAX_RETRIES=0
LLM_TIMEOUT=60

# Optional Infinite gateway: configure privately; this is not an agent API key.
INFINITE_API_BASE=
INFINITE_GATEWAY_CONFIG=outputs/private/infinite_gateway.auth.json

# Optional SPES v2 Nemotron adapter: use a dedicated model API key, not Scientific AI login credentials.
# The Gemini-only v2 control needs only GEMINI_API_KEY above and pins gemini-4-argon internally.
NEBIUS_TOKEN_FACTORY_API_KEY=
NVIDIA_API_KEY=
# Leave these unset for automatic official endpoint selection.
# V2_NEMOTRON_KEY_ENV=NEBIUS_TOKEN_FACTORY_API_KEY
# V2_NEMOTRON_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
# V2_NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b
